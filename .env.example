MONGODB_URI=
MONGODB_DB=poly_recorder
DATA_DIR=/mnt/poly-data
PORT=3849
# Required. recorder = the one live instance that captures ticks. viewer = read-only UI (never records).
RECORDER_ROLE=viewer
# Optional. When set, the browser UI asks for this password. Leave empty for a local viewer.
SITE_PASSWORD=
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
